# ---------------------------------------------------------------------------
# Darukaa.Earth backend configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL + PostGIS connection string.
# Local (docker compose):  postgresql+psycopg://darukaa:darukaa@localhost:5432/darukaa
# Neon (managed PostGIS):  postgresql+psycopg://USER:PASS@ep-xxx-pooler.region.aws.neon.tech/DB
DATABASE_URL=postgresql+psycopg://darukaa:darukaa@localhost:5432/darukaa

# Comma-separated list of allowed browser origins (the Vercel frontend URL goes here).
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME=Darukaa.Earth
ENVIRONMENT=development
LOG_LEVEL=INFO

# Demo credentials used by `python -m app.services.seed`
FIRST_SUPERUSER_EMAIL=admin@darukaa.earth
FIRST_SUPERUSER_PASSWORD=Admin@12345
